FACEMARKET_API_KEY=lk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FACEMARKET_BASE_URL=https://facemarket.ai/vih/dispatcher
PORT=8787

# Only set this when deployed behind a reverse proxy (e.g. nginx — see
# docs/nginx/). Number of proxy hops in front of this process, usually 1.
# Leave unset when running directly (local dev, or exposed without a proxy)
# — trusting forwarded headers with nothing actually in front would let
# clients spoof their own IP and bypass rate limiting.
# TRUST_PROXY=1

# Path prefix the whole app (API + frontend) is mounted under, e.g.
# "/liveavatar" if reverse-proxied there. Drives index.js's own routes AND
# (via web/vite.config.js reading this same variable) the built asset URLs
# and the frontend's own API calls — set it once here instead of editing
# vite.config.js/main.js by hand. Leave unset for the default: root-mounted
# ("/"), works with the plain reverse-proxy examples in docs/nginx/.
# BASE_PATH=/liveavatar
